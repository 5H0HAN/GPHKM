{
  "name": "gphkm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check-rls:local": "node --env-file=.env scripts/check-local-rls.ts",
    "db:check-import-apply:local": "node --conditions=react-server --env-file=.env --import tsx scripts/check-catalog-import-apply-local.ts",
    "db:check-private-files:local": "node --env-file=.env scripts/check-local-private-files.ts",
    "db:check-content-race:local": "node --env-file=.env scripts/check-content-handoff-race-local.ts",
    "db:check-supplier-failure-migration:local": "node --env-file=.env scripts/check-supplier-failure-migration-local.ts",
    "db:check-supplier-recovery:local": "node --env-file=.env scripts/check-supplier-recovery-local.ts",
    "db:check-recipient-reconsent:local": "node --env-file=.env scripts/check-recipient-reconsent-local.ts",
    "db:check-session-guard:local": "NODE_ENV=development node --env-file=.env scripts/check-customer-session-revocation-local.ts",
    "db:check-staff-mfa:local": "NODE_ENV=development node --env-file=.env scripts/check-staff-mfa-local.ts",
    "auth:bootstrap:local": "NODE_ENV=development node --env-file=.env scripts/bootstrap-local-admin.ts",
    "worker:provision-local": "node --env-file=.env scripts/provision-local-notification-worker.ts",
    "roles:provision-local": "node --env-file=.env scripts/provision-local-restricted-roles.ts",
    "worker": "node --conditions=react-server --env-file=.env scripts/customer-notification-worker.ts",
    "worker:notifications": "npm run worker"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12",
    "saxen": "11.2.0",
    "server-only": "0.0.1",
    "stripe": "23.0.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "^26",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-react-a11y": "2.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  }
}
