# Local development only. Replace both passwords before starting Docker Compose.
POSTGRES_MIGRATION_PASSWORD=replace-with-a-long-random-local-secret
GPHKM_DATABASE_PASSWORD=replace-with-a-different-long-random-local-secret
GPHKM_WORKER_PASSWORD=replace-with-a-third-long-random-local-secret
GPHKM_WEBHOOK_PASSWORD=replace-with-a-fourth-long-random-local-secret
GPHKM_RESEND_WEBHOOK_PASSWORD=replace-with-a-fifth-long-random-local-secret
GPHKM_MFA_PROOF_PASSWORD=replace-with-a-sixth-long-random-local-secret
DATABASE_URL=postgres://gphkm_runtime:replace-with-a-different-long-random-local-secret@127.0.0.1:54329/gphkm
MIGRATION_DATABASE_URL=postgres://gphkm_migration:replace-with-a-long-random-local-secret@127.0.0.1:54329/gphkm
WORKER_DATABASE_URL=postgres://gphkm_worker:replace-with-a-third-long-random-local-secret@127.0.0.1:54329/gphkm
STRIPE_WEBHOOK_DATABASE_URL=postgres://gphkm_webhook:replace-with-a-fourth-long-random-local-secret@127.0.0.1:54329/gphkm
RESEND_WEBHOOK_DATABASE_URL=postgres://gphkm_resend_webhook:replace-with-a-fifth-long-random-local-secret@127.0.0.1:54329/gphkm
MFA_PROOF_DATABASE_URL=postgres://gphkm_mfa_proof:replace-with-a-sixth-long-random-local-secret@127.0.0.1:54329/gphkm

# Local-only credential fixture: set true only with NODE_ENV=development.
GPHKM_LOCAL_AUTH_ENABLED=false
# Set true only for development while GPHKM_LOCAL_AUTH_ENABLED=true.
GPHKM_LOCAL_MFA_DISABLED=false
CUSTOMER_APP_URL=http://customer.localhost:3000
STAFF_APP_URL=http://staff.localhost:3000
# Production: comma-separated exact proxy IPs/CIDRs that may append to X-Forwarded-For.
GPHKM_TRUSTED_PROXY_CIDRS=
# Generate with `openssl rand -base64 32` or `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_CUSTOMER_EMAIL=
BOOTSTRAP_CUSTOMER_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GPHKM_TERMS_VERSION=
GPHKM_PRIVACY_VERSION=
GPHKM_NEWSLETTER_NOTICE_VERSION=newsletter-v1
GPHKM_TERMS_URL=
GPHKM_PRIVACY_URL=
# Production must use a restricted rk_live_ key with only the documented scopes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Both stay false until every documented real-money launch gate is approved.
GPHKM_REAL_MONEY_ENABLED=false
GPHKM_LAUNCH_GATES_VERIFIED=false

# Auth verification/reset email and the optional delivery worker use Resend only after
# sender-domain, webhook (where applicable), and data-handling approval.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_ID=
RESEND_WEBHOOK_SECRET=
GPHKM_PUBLIC_BASE_URL=
GPHKM_RESEND_DATA_HANDLING_APPROVED=false
# Generate a separate 32-byte AES-256 key (64 hex characters); keep in the secret store.
GPHKM_INVITATION_TOKEN_ENCRYPTION_KEY=

# Optional server-only Open PageRank key from Keywords Everywhere; never use NEXT_PUBLIC_.
OPEN_PAGE_RANK_API_KEY=
# Keep false until L-05 external licensing/attribution/rights/cost review is complete.
GPHKM_METRIC_CUSTOMER_DISPLAY_L05_VERIFIED=false

# Local development only. Production file storage requires the private object-storage gate in O-02.
GPHKM_PRIVATE_STORAGE_PATH=
